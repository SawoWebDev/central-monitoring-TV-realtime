PORT=4000
CORS_ORIGIN=http://localhost:5173
# Seconds to wait after each sync before the next one (sales data / manufacturing + shipping data)
SYNC_INTERVAL_SECONDS=30
OPERATIONS_SYNC_INTERVAL_SECONDS=120
APP_TIMEZONE=Asia/Manila
ODOO_URL=https://erp.sawo.com
ODOO_DB=sawo
ODOO_USERNAME=
ODOO_API_KEY=
# Max wait for ONE Odoo request. 15000 was too short for some calculated fields (syncs failed after ~16 s).
ODOO_TIMEOUT_MS=60000
ALLOW_WRITABLE_ACCOUNT=false
# true only when the backend sits behind our Nginx (docker-compose.yml sets it). Leave unset in development.
# TRUST_PROXY=false
# Which orders the dashboard uses, by CUSTOMER (optional, default: all)
#   all          = every order of SAWO INC., whoever the customer is
#   own_company  = only orders whose customer is SAWO INC. itself (leaves out sister companies and outside customers)
# CUSTOMER_SCOPE=all
